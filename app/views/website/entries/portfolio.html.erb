<%# locals: (entry:) -%>
<%# A case study's own page. %>
<% study = website_fields(entry) %>
<% content_for :nav, "over_photo" %>
<% photos = ([study.hero_image] + study.gallery.flat_map { |row| row.images.map(&:image) }).compact_blank.uniq.filter_map { website_image(it) } %>
<% content_for :head do %>
  <%= website_seo_tags entry, description: study.description, image: study.hero_image %>
  <%# The case study itself (the page's #main): where it is and its photos. %>
  <%= website_json_ld({"@context" => "https://schema.org", "@type" => "CreativeWork", "@id" => "#{website_url(request.path)}#main", "name" => entry.title,
    "description" => study.description, "creator" => {"@id" => "#{website_url("/")}#organization"}, "dateCreated" => study.date&.to_s&.first(10),
    "contentLocation" => ({"@type" => "Place", "name" => study.location} if study.location.present?),
    "image" => photos.map { website_url(it[:src]) }.presence}.compact) %>
<% end %>
<% cards = [["target", "Goal", "What they wanted", study.goal, "goal"], ["alert-triangle", "Challenges", "What stood in the way", study.challenges, "challenges"],
  ["bulb", "Solution", "What we did", study.solution, "solution"], ["plant-2", "Outcome", "What changed", study.outcome, "outcome"]].reject { website_plain_text(it[3]).blank? } %>
<% rows = study.gallery.map { |row| row.images.map(&:image).compact_blank }.reject(&:empty?) %>
<% others = healing_case_studies.reject { it.slug == entry.slug } %>
<div class="study-hero">
  <%= website_image_tag study.hero_image, loading: :eager, fetchpriority: :high, style: "view-transition-name: portfolio-#{entry.slug}" %>
</div>
<article class="container container--study study">
  <h1 class="h1 muted study__title"><%= entry.title %></h1>
  <% if study.location.present? %>
    <p class="h3 study__location"><%= study.location %></p>
  <% end %>
  <%# The story in four cards, numbered: the goal and the challenges, what we did, and the outcome, set apart in the dark. %>
  <ol class="study__cards" data-reveal-group>
    <% cards.each_with_index do |(icon, title, kicker, text, key), index| %>
      <% card_class = "study-card study-card--#{key}" %>
      <li class="<%= card_class %>">
        <div class="study-card__head">
          <span class="study-card__icon"><%= healing_icon(icon) %></span>
          <span class="study-card__num"><%= format("%02d", index + 1) %></span>
        </div>
        <p class="study-card__kicker"><%= kicker %></p>
        <h2 class="study-card__title"><%= title %></h2>
        <p class="study-card__text"><%= website_plain_text(text) %></p>
      </li>
    <% end %>
  </ol>
  <% if entry.body_markdown.present? %>
    <div class="prose study__body"><%= website_markdown(entry.body_markdown) %></div>
  <% end %>
  <%# The photos in rows; each opens the lightbox (healing/controllers/lightbox_controller). %>
  <% photo_count = rows.sum(&:size) %>
  <div class="gallery" data-controller="lightbox">
    <% index = 0 %>
    <% rows.each do |row| %>
      <% row_class = "gallery__row gallery__row--#{[row.size, 3].min}" %>
      <div class="<%= row_class %>">
        <% row.each do |image| %>
          <%= tag.button(type: "button", class: "gallery__open", "aria-label": "Open photo #{index + 1} of #{photo_count}", data: {action: "lightbox#open", lightbox_index_param: index}) do %>
            <%= website_image_tag image, sizes: "(min-width: 1024px) #{(1120.0 / row.size).round}px, #{(100.0 / row.size).round}vw", data: {lightbox_target: "thumb"} %>
          <% end %>
          <% index += 1 %>
        <% end %>
      </div>
    <% end %>
    <dialog class="lightbox" aria-label="Photos" data-lightbox-target="dialog"
      data-action="close->lightbox#closed click->lightbox#backdrop keydown->lightbox#keydown pointerdown->lightbox#swipeStart pointerup->lightbox#swipeEnd">
      <figure class="lightbox__figure">
        <img class="lightbox__image" src="data:," alt="" data-lightbox-target="image">
        <figcaption class="lightbox__caption" data-lightbox-target="caption" hidden></figcaption>
      </figure>
      <p class="lightbox__count" data-lightbox-target="count"></p>
      <button type="button" class="lightbox__button lightbox__close" aria-label="Close" data-action="lightbox#close"><%= healing_icon("x") %></button>
      <button type="button" class="lightbox__button lightbox__prev" aria-label="Previous photo" data-action="lightbox#prev"><%= healing_icon("arrow-long-left") %></button>
      <button type="button" class="lightbox__button lightbox__next" aria-label="Next photo" data-action="lightbox#next"><%= healing_icon("arrow-long-right") %></button>
    </dialog>
  </div>
</article>
<%= render "website/shared/testimonial_quote" %>
<% if others.any? %>
  <section class="container container--grid more-studies">
    <% if healing_settings.case_study_page.more_heading.present? %>
      <h2 class="h2 centered"><%= healing_settings.case_study_page.more_heading %></h2>
    <% end %>
    <%# Not morphing: these would fly to this page's grid and leave the card that was clicked alone. %>
    <%= render "website/shared/portfolio_grid", portfolios: others, morph: false %>
  </section>
<% end %>
<%= render "website/shared/contact", source: "case study: #{entry.title}" %>
