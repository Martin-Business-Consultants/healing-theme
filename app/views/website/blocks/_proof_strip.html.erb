<%# locals: (data:) -%>
<%# Credentials, directly under the hero. %>
<section class="proof" aria-label="Why work with Sarah">
  <ul class="container proof__list" data-reveal-group>
    <% data.items.each do |item| %>
      <li>
        <svg viewBox="0 0 24 24" class="icon proof__leaf" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14Z" /><path d="M5 19 13 11" /></svg>
        <span><%= item %></span>
      </li>
    <% end %>
  </ul>
</section>
