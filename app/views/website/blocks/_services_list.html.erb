<%# locals: (data:) -%>
<%# Every published service as a card; with a heading, a full section with an intro and a button. %>
<% button_href = website_href(data.button_link) %>
<section id="services" class="section <%= "section--muted" if data.background == "tinted" %>">
  <div class="container">
    <% if data.heading.present? %>
      <div class="section-head section-head--spaced" data-reveal>
        <div class="section-head__intro">
          <% if data.eyebrow.present? %>
            <p class="eyebrow"><%= data.eyebrow %></p>
          <% end %>
          <h2 class="h2 section-head__title"><%= data.heading %></h2>
          <% if data.body.present? %>
            <p class="lead muted"><%= data.body %></p>
          <% end %>
        </div>
        <% if data.button_label.present? && button_href %>
          <%= healing_button data.button_label, href: button_href, variant: :outline, arrow: true %>
        <% end %>
      </div>
    <% end %>
    <%= render "website/shared/service_cards" %>
  </div>
</section>
