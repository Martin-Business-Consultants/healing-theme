<%# locals: (page:) -%>
<%# On the home page, what the business is, from Settings › General. %>
<% settings = website_settings %>
<% address = {"@type" => "PostalAddress", "streetAddress" => settings["address_line1"], "addressLocality" => settings["city"],
  "addressRegion" => settings["state"], "postalCode" => settings["zip"], "addressCountry" => "US"} if settings["address_line1"].present? && settings["city"].present? %>
<% image = website_image(page.seo.to_h["og_image_id"].presence || healing_settings.share_image) %>
<%= website_json_ld({
  "@context" => "https://schema.org", "@type" => page.seo.to_h["schema_type"].presence || "LocalBusiness",
  "name" => settings["title"], "description" => settings["description"].presence || page.seo.to_h["meta_description"],
  "url" => website_url("/"), "email" => settings["email"].presence, "telephone" => settings["phone"].presence, "address" => address,
  "image" => (website_url(image[:src]) if image), "founder" => {"@type" => "Person", "name" => "Sarah Martin"}
}.compact) %>
