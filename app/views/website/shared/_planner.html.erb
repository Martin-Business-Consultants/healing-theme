<%# locals: (heading:, eyebrow: nil, intro: nil, points: [], source: nil, property: nil, checked: []) -%>
<%# The commercial project planner's section (#plan): its words beside the planner (shared/planner_form) for the "commercial" form. `property` preselects the kind of property (an industry's page), `checked` ticks services (a service's page). %>
<section id="plan" class="section section--tint planner-section">
  <div class="container planner-section__grid">
    <div class="planner-section__intro" data-reveal>
      <% if eyebrow.present? %>
        <p class="eyebrow"><%= eyebrow %></p>
      <% end %>
      <h2 class="h2"><%= heading %></h2>
      <% if intro.present? %>
        <p class="lead muted"><%= intro %></p>
      <% end %>
      <% if points.any? %>
        <ul class="contact__highlights">
          <% points.each do |point| %>
            <li><%= healing_icon("check") %><span><%= point %></span></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <%= render "website/shared/planner_form", planner: healing_planner(:commercial), source:, property:, checked: %>
  </div>
</section>
