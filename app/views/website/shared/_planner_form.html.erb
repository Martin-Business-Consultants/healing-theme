<%# locals: (planner:, source: nil, property: nil, checked: []) -%>
<%# A planner (HealingHelper::PLANNERS): its CMS form in steps, then a review of the answers before it's sent. Questions, choices, the button and the thank-you are the form's; a field the steps don't name joins the last step, so one added in the CMS still shows. Each service choice shows what that service includes (the planner's services, by their "planner_choice"), and its icon field's choices are cards with icons. Without scripts it's one long form; healing/planner.js makes it steps, and it posts like the contact form (healing/contact_form.js), "estimate" carrying a calculator's result. `property` preselects the icon field's choice, `checked` ticks services. A "tracking" field, when the form has one, carries the ad click and UTM tags (healing/attribution.js). %>
<% form = planner[:form] %>
<% steps = planner[:steps].map { |title, hint, names| [title, hint, names.dup] } %>
<% hidden = %w[estimate source].map { website_form_field(form, it)["name"] } %>
<% tracking = form.fields.find { it["name"] == "tracking" } %>
<% hidden << tracking["name"] if tracking %>
<% named = steps.flat_map(&:last) %>
<% named.each { website_form_field(form, it) } %>
<% steps.last.last.concat(form.fields.map { it["name"] } - named - hidden) %>
<% services = website_entries(planner[:services]).index_by { website_fields(it).planner_choice } %>
<% icons = planner[:icons] %>
<% thank_you = website_href(healing_settings.contact.thank_you_page) %>
<form id="<%= planner[:id] %>" class="card card--form planner" method="post" action="<%= api_form_submissions_path(form_slug: form.slug) %>" novalidate
  data-contact-form data-planner data-honeypot="<%= Form::HONEYPOT_FIELD %>" data-success="<%= form.success_message %>"<% if thank_you %> data-redirect="<%= thank_you %>"<% end %>>
  <input type="hidden" name="<%= website_form_field(form, :source)["name"] %>" value="<%= source.presence || planner[:source] %>">
  <input type="hidden" name="<%= website_form_field(form, :estimate)["name"] %>" value="" data-planner-estimate data-estimate>
  <% if tracking %>
    <input type="hidden" name="<%= tracking["name"] %>" value="" data-tracking>
  <% end %>
  <p hidden aria-hidden="true">
    <label>Leave this empty: <input name="<%= Form::HONEYPOT_FIELD %>" tabindex="-1" autocomplete="off"></label>
  </p>
  <ol class="planner__progress" aria-label="Steps" data-planner-progress hidden>
    <% (steps.map(&:first) + ["Review"]).each_with_index do |title, index| %>
      <li class="planner__progress-step" data-planner-dot="<%= index %>"><span class="planner__progress-num"><%= index + 1 %></span><span class="planner__progress-label"><%= title %></span></li>
    <% end %>
  </ol>
  <div class="planner__bar" aria-hidden="true" hidden data-planner-bar><span></span></div>
  <% steps.each_with_index do |(title, hint, names), index| %>
    <fieldset class="planner__step" data-planner-step="<%= index %>">
      <legend class="planner__legend"><span class="planner__count">Step <%= index + 1 %> of <%= steps.size %></span><%= title %></legend>
      <p class="small muted planner__hint"><%= hint %></p>
      <div class="planner__fields">
      <% checkboxes = names.map { website_form_field(form, it) }.select { it["type"] == "checkbox" } %>
      <% if checkboxes.any? %>
        <div class="choice-grid choice-grid--services" role="group" aria-label="Services">
          <% checkboxes.each do |field| %>
            <% service = services[field["name"]] %>
            <% service_fields = website_fields(service) if service %>
            <label class="choice choice--service">
              <%= tag.input(type: "checkbox", name: field["name"], value: "Yes", class: "choice__input", checked: checked.include?(field["name"])) %>
              <span class="choice__body">
                <span class="choice__icon"><%= healing_icon(service_fields&.icon.presence || "plant-2") %></span>
                <span class="choice__title"><%= field["label"] %></span>
                <% if service_fields&.summary.present? %>
                  <span class="choice__text"><%= service_fields.summary %></span>
                <% end %>
                <% if service_fields&.features&.any? %>
                  <span class="choice__more" data-choice-more>
                    <span class="choice__more-inner">
                      <% service_fields.features.first(3).each do |feature| %>
                        <span><%= healing_icon("check") %><%= feature %></span>
                      <% end %>
                    </span>
                  </span>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      <% end %>
      <% names.each do |name| %>
        <% field = website_form_field(form, name) %>
        <% next if field["type"] == "checkbox" %>
        <% input_id = "#{planner[:id]}-#{name}" %>
        <% if field["type"] == "radio" %>
          <% icon_choices = name == planner[:icon_field] %>
          <div class="field field--wide" role="radiogroup" aria-labelledby="<%= input_id %>-label"<% if field["required"] %> aria-required="true"<% end %>>
            <p class="field__label" id="<%= input_id %>-label">
              <%= field["label"] %>
              <% unless field["required"] %>
                <span class="field__optional">(optional)</span>
              <% end %>
            </p>
            <div class="choice-grid <%= icon_choices ? "choice-grid--icons" : "choice-grid--pills" %>">
              <% FormChoices.for(field).each do |option| %>
                <% key = icons.keys.find { option["value"].downcase.include?(it) } %>
                <label class="choice <%= icon_choices ? "choice--icon" : "choice--pill" %>">
                  <%= tag.input(type: "radio", name:, value: option["value"], class: "choice__input", required: field["required"].present?, checked: property.present? && option["value"] == property) %>
                  <span class="choice__body">
                    <% if icon_choices %>
                      <span class="choice__icon"><%= healing_icon(icons[key] || "plant-2") %></span>
                    <% end %>
                    <span class="choice__title"><%= option["label"] %></span>
                  </span>
                </label>
              <% end %>
            </div>
            <p class="field__error" data-error-for="<%= name %>" data-label="<%= field["label"] %>" hidden></p>
          </div>
        <% else %>
          <% short = %w[text email tel url].include?(field["type"]) %>
          <div class="field <%= "field--wide" unless short %>">
            <label class="field__label" for="<%= input_id %>">
              <%= field["label"] %>
              <% unless field["required"] %>
                <span class="field__optional">(optional)</span>
              <% end %>
            </label>
            <%= healing_form_control(field, id: input_id) %>
            <p class="field__error" data-error-for="<%= name %>" data-label="<%= field["label"] %>" hidden></p>
          </div>
        <% end %>
      <% end %>
      </div>
    </fieldset>
  <% end %>
  <div class="planner__step planner__review" data-planner-step="<%= steps.size %>" data-planner-review hidden>
    <p class="planner__legend"><span class="planner__count">Last step</span>Check your answers</p>
    <p class="small muted planner__hint">Here's what I'll receive. Go back to change anything.</p>
    <dl class="planner__summary" data-planner-summary></dl>
  </div>
  <% if (turnstile = healing_turnstile) %>
    <% content_for :turnstile, "on" %>
    <div class="cf-turnstile" data-sitekey="<%= turnstile[:site_key] %>" data-theme="<%= turnstile[:theme] %>" data-size="flexible"></div>
  <% end %>
  <div class="planner__nav">
    <button type="button" class="button button--ghost planner__back" data-planner-back hidden><%= healing_icon("arrow-long-left") %><span>Back</span></button>
    <button type="button" class="button button--primary planner__next" data-planner-next hidden><span>Next</span><%= healing_icon("arrow-long-right", class: "button__arrow") %></button>
    <%= healing_button form.submit_label.presence || "Send", type: :submit, arrow: true, class: "planner__submit" %>
  </div>
  <p class="contact-form__status" data-form-status role="status" aria-live="polite" hidden></p>
</form>
