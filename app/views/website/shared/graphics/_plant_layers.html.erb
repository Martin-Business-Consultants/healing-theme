<%# locals: () -%>
<%# A planting in layers, in profile: canopy, shrubs, perennials and groundcover, the way a detailed design plans them so the garden is full from the ground up and has something in every season. Drawn in on scroll (data-draw). %>
<figure class="graphic graphic--panel" data-reveal>
  <svg viewBox="0 0 800 400" role="img" aria-labelledby="plant-layers-title plant-layers-desc">
    <title id="plant-layers-title">A planting designed in layers</title>
    <desc id="plant-layers-desc">A profile of a designed planting: a canopy tree, shrubs beneath it, perennials in front and a groundcover at the edge, each labeled as a layer.</desc>
    <rect class="g-sky" width="800" height="400" />
    <%# the layers' guides %>
    <% [[80, "Canopy", "trees for shade and structure"], [170, "Shrubs", "berries, flowers and winter form"], [240, "Perennials", "bloom from spring to fall"], [296, "Groundcover", "covers soil, crowds out weeds"]].each do |y, name, note| %>
      <path class="g-guide" d="M24 <%= y %>h540" data-draw />
      <text class="g-label" x="580" y="<%= y + 4 %>"><%= name %></text>
      <text class="g-label g-label--small" x="580" y="<%= y + 22 %>"><%= note %></text>
    <% end %>
    <%# canopy tree %>
    <path class="g-trunk" d="M150 340v-150q0-20-14-40M150 230q14-20 34-30" />
    <path class="g-canopy" d="M60 132q-10-70 70-82q30-40 90-10q70 0 64 60q20 50-40 66q-40 26-100 6q-70 6-84-40z" />
    <%# shrubs %>
    <path class="g-shrub" d="M240 340q-30-10-24-60q10-50 60-56q50 4 58 56q4 54-30 60z" />
    <% [[250, 252], [282, 236], [300, 270], [268, 286]].each do |x, y| %><circle class="g-berry" cx="<%= x %>" cy="<%= y %>" r="5" /><% end %>
    <path class="g-shrub g-shrub--light" d="M60 340q-16-40 12-74q30-24 60 4q22 30 8 70z" />
    <%# perennials %>
    <% [370, 404, 438, 472].each_with_index do |x, i| %>
      <path class="g-line g-stem" d="M<%= x %> 340v-<%= 70 + (i % 2) * 14 %>" />
      <circle class="g-bloom" cx="<%= x %>" cy="<%= 266 - (i % 2) * 14 %>" r="9" />
      <circle class="g-bloom-eye" cx="<%= x %>" cy="<%= 266 - (i % 2) * 14 %>" r="3.5" />
    <% end %>
    <path class="g-line g-stem" d="M340 340q-6-40-20-60M340 340q2-50 6-74M340 340q8-40 24-52" />
    <%# groundcover %>
    <path class="g-leaf" d="M180 340q20-22 50-20q30-14 60 0q30-14 60 4q40-10 70 16z" />
    <path class="g-leaf g-leaf--dark" d="M440 340q20-20 46-16q26-12 50 2q16 0 24 14z" />
    <path class="g-native" d="M0 340h570v60h-570z" />
    <path class="g-line g-ground" d="M0 340h570" />
  </svg>
  <figcaption class="small muted">A detailed design plans every layer, so the garden looks full and gives something in every season.</figcaption>
</figure>
