<%# locals: (text: nil, attribution: nil, testimonial: nil) -%>
<%# A large client quote on a dark band: a testimonial picked in the CMS (`testimonial`, a Testimonials slug), else text of its own, else Site settings' featured quote. %>
<% featured = healing_settings.quote %>
<% picked = healing_testimonials.find { it.slug == testimonial } if testimonial.present? %>
<% own = website_plain_text(text).presence %>
<% quote = (picked && website_plain_text(website_fields(picked).quote).presence) || own || featured.text.to_s.strip.presence %>
<% name = (picked ? picked.title : (own ? attribution : featured.attribution)).to_s.sub(/\A[-–—\s]+/, "").presence %>
<% if quote %>
  <figure class="pull-quote">
    <div class="container container--narrow" data-reveal>
      <span class="pull-quote__mark" aria-hidden="true">“</span>
      <blockquote><%= quote %></blockquote>
      <% if name %>
        <figcaption><%= name %></figcaption>
      <% end %>
    </div>
  </figure>
<% end %>
