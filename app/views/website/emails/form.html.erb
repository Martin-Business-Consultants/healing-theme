<%# locals: (email:) -%>
<%# A form email (notification or confirmation) in the site's design, drawn from its blocks each time it's sent. The Forms plugin then repeats the answers row once per answer and fills the {{tokens}}. Mail clients need tables and inline styles, so this uses nothing else; the colours are the site's (site.css), in hex. %>
<% c = {page: "#f1f4ee", card: "#fbfcf9", ink: "#262f28", muted: "#4b564d", rule: "#dde2da", green: "#2c4834", tint: "#eef3eb"} %>
<% serif = "'Playfair Display', Georgia, 'Times New Roman', serif" %>
<% sans = "'Work Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif" %>
<% name = website_settings["title"].presence || "Healing Earth Design" %>
<% home = website_url("/") %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= email.subject %></title>
  </head>
  <body style="margin:0;padding:0;background:<%= c[:page] %>;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:<%= c[:page] %>;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
            <tr>
              <td style="padding:0 8px 20px;font-family:<%= serif %>;font-size:18px;letter-spacing:2px;text-transform:uppercase;color:<%= c[:green] %>;">
                <%= tag.a name, href: home, style: "color:#{c[:green]};text-decoration:none;" %>
              </td>
            </tr>
            <tr>
              <td style="background:<%= c[:card] %>;border:1px solid <%= c[:rule] %>;border-top:4px solid <%= c[:green] %>;border-radius:12px;padding:36px 36px 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <% email.content_blocks.each do |block| %>
                    <%= render "website/emails/block", block:, c:, serif:, sans: %>
                  <% end %>
                </table>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:20px 8px 0;font-family:<%= sans %>;font-size:12px;line-height:1.5;color:<%= c[:muted] %>;">
                <%= name %> &middot; <%= tag.a home.sub(%r{\Ahttps?://}, "").chomp("/"), href: home, style: "color:#{c[:muted]};" %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
